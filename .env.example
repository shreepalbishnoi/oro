# Copy to .env (never commit .env). Every AI key is optional: without any, Parakh runs on
# rules + records ("records-only" mode) and still works.

ENV=dev
LOG_LEVEL=INFO

POSTGRES_PASSWORD=xxxxx
# Used when running the API outside Docker:
DATABASE_URL=postgresql+asyncpg://oro:xxxxx@localhost:5432/oro
REDIS_URL=redis://localhost:6379/0

# Shared with apps/web: the Next.js server mints short-lived HS256 tokens for API calls.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=xxxxx
HASH_PEPPER=xxxxx
# 32 random bytes, base64: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes stored holdings unreadable. Back it up outside the server.
FIELD_KEY_B64=xxxxx

CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_EMAILS=[]

# ---- AI (free first) ----
# Groq free plan: main model for user tips (no training on inputs). console.groq.com
GROQ_API_KEY=xxxxx
GROQ_MODEL=openai/gpt-oss-120b
# Gemini free tier: PUBLIC filings only (free-tier input may be human-reviewed). aistudio.google.com
GEMINI_API_KEY=xxxxx
# Optional paid quality tier. Leave empty to stay at ₹0.
ANTHROPIC_API_KEY=xxxxx
LLM_DAILY_BUDGET_INR=12
USD_INR=96
# live | replay (tests) | off (rules only)
LLM_MODE=live

# Embeddings: self-hosted EmbeddingGemma (free). Empty EMBED_URL loads the model in-process (dev).
EMBED_ENABLED=true
EMBED_URL=

# Abuse protection (Cloudflare Turnstile). Empty = skipped (dev only).
TURNSTILE_SECRET=xxxxx
ANON_CHECKS_PER_DAY=3
USER_CHECKS_PER_DAY=10

# Telegram bot (later milestone)
TELEGRAM_BOT_TOKEN=xxxxx
TELEGRAM_WEBHOOK_SECRET=xxxxx

# Production only: the domain Caddy serves (the API stays private behind the web app)
SITE_DOMAIN=example.in

# ---- Web (Next.js) ----
# Better Auth session signing: python -c "import secrets; print(secrets.token_urlsafe(48))"
BETTER_AUTH_SECRET=xxxxx
# Optional: Google sign-in (Google Cloud console → OAuth client ID, type Web)
GOOGLE_CLIENT_ID=xxxxx
GOOGLE_CLIENT_SECRET=xxxxx
# Optional: Cloudflare Turnstile site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=xxxxx

# ---- Deployment (infra/deploy.sh) ----
# caddy (ports 80/443 on the server) | tunnel (Cloudflare Tunnel, no open ports)
ORO_EDGE=caddy
# small = 2–4 GB server; empty = full size (8 GB+)
ORO_SIZE=
SMALL_EMBED=
CLOUDFLARE_TUNNEL_TOKEN=xxxxx

# ---- Web Push alerts ----
# Generate: python -m app.alerts.push (in backend/)
VAPID_PUBLIC_KEY=xxxxx
VAPID_PRIVATE_KEY=xxxxx
# mailto:you@domain or https://domain
VAPID_SUBJECT=mailto:you@example.com
# Caddy (ORO_EDGE=caddy): Cloudflare API token with Zone.DNS:Edit for your zone (DNS-01 certificates)
CLOUDFLARE_API_TOKEN=xxxxx
ACME_EMAIL=you@example.com
